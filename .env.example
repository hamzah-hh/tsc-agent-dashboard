# ---------------------------------------------------------------------------
# Server settings. On the published app these are the AI Studio "Secrets".
# For a local run, copy this file to .env.local and fill it in (.env* is git-ignored).
# ---------------------------------------------------------------------------

# SYNC_KEY: the shared secret between the Google Sheet's Apps Script and this server.
# Use 24 or more random characters, and a DIFFERENT value in the test and the live account.
# The same value goes into the Apps Script property SYNC_KEY. Without it the sheet cannot sync.
SYNC_KEY="CHANGE_ME_TO_24_OR_MORE_RANDOM_CHARACTERS"

# GEMINI_API_KEY: only for the optional AI coaching text (Admin tab > AI).
# AI Studio injects this at runtime from your secrets. Without it the app shows the rule-based text.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: the URL where this applet is hosted (AI Studio sets it to the Cloud Run URL).
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Used ONCE, when a brand-new project creates config/app. After that, people are managed
# in the Admin tab (Roles & access). Comma-separated Gmail addresses.
# SUPER_ADMIN_EMAILS="you@gmail.com"
# MANAGER_EMAILS="manager1@gmail.com,manager2@gmail.com"

# How long a sync may spend on AI text AFTER the data is saved (milliseconds). Default 35000.
# AI_SYNC_BUDGET_MS=35000

# ---------------------------------------------------------------------------
# Development and tests only. NEVER set these on the live app.
# ---------------------------------------------------------------------------

# DB_MODE=local            # in-memory database instead of Firestore (the browser cannot see it)
# DB_LOCAL_FILE=none       # with DB_MODE=local: "none" keeps nothing on disk (default file: local-db.json)
# FIRESTORE_EMULATOR_HOST=localhost:8080
