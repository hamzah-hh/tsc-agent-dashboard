# Sync key between Google Sheets (Apps Script) and the dashboard API. Required: without it every
# sync is refused. 24+ random characters; the same value goes in the Apps Script's Script Properties.
SYNC_KEY=

# Firebase Admin service-account key (the JSON, or the JSON base64-encoded). Required on Vercel.
FIREBASE_SERVICE_ACCOUNT=

# Gemini API key for server-side AI coaching generation
GEMINI_API_KEY=

# Optional: Initial administrators (defaults to agha.h489@gmail.com)
SUPER_ADMIN_EMAILS=
MANAGER_EMAILS=

# Optional: DB storage override ('firestore' or 'local')
DB_MODE=
