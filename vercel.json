{
  "version": 2,
  "buildCommand": "npm run build && npm run build:api",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
